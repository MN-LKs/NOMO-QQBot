    "test:jsmini": "node test/jsmini.test.mjs",
    "test:integration": "node test/integration.js",
    "test:all": "node tools/scan-secrets.js && node test/run.js && node test/jsmini.test.mjs && node test/integration.js"
  },
  "devDependencies": {
    "wrangler": "^4.20.0"
