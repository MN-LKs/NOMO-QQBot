{
  "name": "nomo-qqbot",
  "version": "4.0.0",
  "private": true,
  "description": "NOMO-QQBot:QQ 官方机器人 + AI Agent + 在线部署,运行在 Cloudflare Workers 上,自带管理面板",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "wrangler dev",
